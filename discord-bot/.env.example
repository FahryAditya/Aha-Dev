# Discord Bot Credentials
# Dapatkan dari https://discord.com/developers/applications
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
DISCORD_CLIENT_ID="YOUR_APPLICATION_CLIENT_ID_HERE"

# Akun Discord Developer Penerima Order
# Klik kanan profil kamu di Discord > Copy User ID
DEVELOPER_USER_ID="YOUR_DISCORD_USER_ID"

# (Opsional) Jika ingin dikirim ke Channel Server alih-alih DM
DISCORD_CHANNEL_ID=""

# Database PostgreSQL (Sama dengan database website)
DATABASE_URL="postgresql://user:password@localhost:5432/aha_dev?schema=public"

# Interval Polling (milidetik)
POLL_INTERVAL_MS="5000"
